# Copy to .env and fill in. Never commit .env. Placeholders only.

# --- Dashboard sign-in -------------------------------------------------------
# "google" (real OAuth) or "local" (development-only demo login; see README section 13)
AUTH_MODE=google

# Domain allowed to sign in. For now gmail.com with an explicit email allowlist.
ALLOWED_DOMAIN=gmail.com
# Comma-separated. REQUIRED while ALLOWED_DOMAIN is gmail.com or googlemail.com (startup fails otherwise).
ALLOWED_EMAILS=first.member@gmail.com,second.member@gmail.com

# Google OAuth client (AUTH_MODE=google). Redirect URI must be registered in the Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Through the Vite dev proxy: http://localhost:5173/api/auth/callback
OAUTH_REDIRECT_URI=http://localhost:5173/api/auth/callback

# --- Local demo login (AUTH_MODE=local) ---------------------------------------
# Must be set explicitly; the shared passcode is chosen by you, never hard-coded.
ALLOW_LOCAL_DEMO_LOGIN=
LOCAL_LOGIN_PASSCODE=

# --- Sessions -----------------------------------------------------------------
SESSION_TTL_MINUTES=60
# "true" in any real deployment (HTTPS). Set "false" only for http://localhost development.
COOKIE_SECURE=true
